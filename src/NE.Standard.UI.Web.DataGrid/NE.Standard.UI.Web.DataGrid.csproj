<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NE.Standard.UI.Web.DataGrid</PackageId>
    <Description>The web rendering of NE.Standard.UI.DataGrid: the grid renderer over the framework's table renderer, the typed cell, and the sorting, filtering and editing engines the package embeds as its own script and stylesheet. Register it with services.AddDataGrid().</Description>
    <PackageTags>NE.Standard,UI,Web,DataGrid,Table,Grid</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NE.Standard.UI.DataGrid\NE.Standard.UI.DataGrid.csproj" />
  </ItemGroup>

  <!-- The framework is a sibling in the monorepo and a package in this slice's mirror. Either way the produced nupkg depends on
       the framework's renderers at $(CoreVersion): the grid renders through the table's renderer, not a copy of it, so it needs
       the built-in renderers rather than the foundation alone. -->
  <ItemGroup Condition="'$(InMonorepo)' == 'true'">
    <ProjectReference Include="..\..\..\..\src\Platforms\Web\NE.Standard.UI.Web.Renderers\NE.Standard.UI.Web.Renderers.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(InMonorepo)' != 'true'">
    <PackageReference Include="NE.Standard.UI.Web.Renderers" Version="$(CoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Client\dist\**" />
    <Content Remove="Client\dist\**" />
  </ItemGroup>

  <PropertyGroup>
    <DataGridClientJs>$(MSBuildProjectDirectory)\Client\dist\ui-data-grid.js</DataGridClientJs>
    <DataGridClientCss>$(MSBuildProjectDirectory)\Client\dist\ui-data-grid.css</DataGridClientCss>
  </PropertyGroup>

  <!-- The client builds as part of dotnet build (WebClient.targets, imported from Directory.Build.targets). -->
  <PropertyGroup>
    <BuildsWebClient>true</BuildsWebClient>
  </PropertyGroup>

  <ItemGroup>
    <WebClientOutput Include="$(DataGridClientJs)" />
    <WebClientOutput Include="$(DataGridClientCss)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(DataGridClientJs)" LogicalName="NE.Standard.UI.Web.DataGrid.Client.dist.ui-data-grid.js" />
    <EmbeddedResource Include="$(DataGridClientCss)" LogicalName="NE.Standard.UI.Web.DataGrid.Client.dist.ui-data-grid.css" />
  </ItemGroup>

</Project>
